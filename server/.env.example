# Faster-Whisper downloads the selected CTranslate2 model into the local
# Hugging Face cache on the first transcription.
# Faster-Whisper defaults optimized for CPU. Use small/medium only if quality
# matters more than speed; use CUDA + float16 when a compatible GPU is available.
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=1
WHISPER_VAD=false
WHISPER_CONDITION_ON_PREVIOUS_TEXT=false

# Behind-person rendering is temporarily off. Set true to restore RVM.
# The official FP32 MobileNetV3 ONNX model is downloaded once into server/models.
RVM_ENABLED=false
RVM_AUTO_DOWNLOAD=true
RVM_MODEL_PATH=
RVM_PROVIDER=
RVM_MAX_INFERENCE_SIZE=512
# Harden the soft matte so captions are fully occluded by the person rather
# than ghosting through skin/clothes; the interval remains feathered at edges.
RVM_ALPHA_LOW=0.08
RVM_ALPHA_HIGH=0.45
RVM_ALPHA_EXPAND=1
RENDER_TIMEOUT_SECONDS=1800

PORT=5000
MAX_UPLOAD_MB=500
FLASK_DEBUG=false
FFMPEG_PRESET=medium
FFMPEG_CRF=21
