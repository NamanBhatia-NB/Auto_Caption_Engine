# Copy this file to .env only if you want optional Groq free-tier transcription.
# Local Whisper mode does not need this key.
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo

# Optional: point at an already downloaded whisper.cpp GGML model.
# Otherwise ggml-small.bin is downloaded from the public Hugging Face model
# repository on the first local transcription.
WHISPER_MODEL_PATH=
# Faster-Whisper defaults optimized for CPU. Use small/medium only if quality
# matters more than speed; use CUDA + float16 when a compatible GPU is available.
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=1
WHISPER_VAD=false
WHISPER_CONDITION_ON_PREVIOUS_TEXT=false

PORT=5000
MAX_UPLOAD_MB=500
FLASK_DEBUG=false
FFMPEG_PRESET=medium
FFMPEG_CRF=21
